# Application Settings
APP_NAME=AI Job Risk Analyzer
APP_VERSION=1.0.0
DEBUG=False

# Database
DATABASE_URL=postgresql://ai_analyzer:password@localhost:5432/ai_risk_analyzer

# JWT Secrets
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Stripe Integration (for future monetization)
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","https://yourdomain.com"]

# Model Artifacts Path
MODEL_ARTIFACTS_PATH=../app/artifacts
